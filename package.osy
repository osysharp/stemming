// Osysharp.Stemming — a word in its base form, per language, so a search for "betalningen" finds "betalningar" and a search
// for "بالبطاقة" finds "البطاقات".
//
//     var stems = new Stemmer().StemText("Så betalar du dina fakturor", "sv");   // "så betal du din faktur"
//
// Index a text's stems beside it (written when the text is), stem a query the same way, and match one against the
// other: two inflections of one word meet in their stem. English, Swedish, Danish, Norwegian and Arabic have stemmers of
// their own — the Snowball rules for the European ones, a light stemmer that removes the article, the conjunction and
// the common suffixes for Arabic; any other language is matched word for word, lower-cased.
//
// Deterministic, offline and fast: a stem is a pure function of the word and its language.
package Osysharp.Stemming {
  version     "0.1.0";
  minPlatform "0.9.0";
  summary     "words in their base form for search — Snowball stemmers for English, Swedish, Danish and Norwegian and a light Arabic stemmer, so an inflected query finds the other forms of its words; any other language matched word for word.";
  model "model/*.osy";
  tests "tests";
}
